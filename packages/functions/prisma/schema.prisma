// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

generator comments {
  provider = "prisma-db-comments-generator"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// ガントチャート
model GanttChart {
  id        Int      @id @default(autoincrement())
  /// ガントチャートの行データをJSONとして保存
  data      Json
  /// 作成者email
  createdBy String?  @default("system")
  createdAt DateTime? @default(now())
  /// 更新者email
  updatedBy String?  @default("system")
  updatedAt DateTime? @default(now())
}

/// ガント行
model GanttRow {
  id        Int      @id @default(autoincrement())
  /// 行ラベル
  name     String
  /// 作成者email
  createdBy String?  @default("system")
  createdAt DateTime? @default(now())
  /// 更新者email
  updatedBy String?  @default("system")
  updatedAt DateTime? @default(now())
  tasks     GanttTask[]
}

/// ガントタスク
model GanttTask {
  id        Int      @id @default(autoincrement())
  /// 行ID
  rowId     Int
  row       GanttRow      @relation(fields: [rowId], references: [id])
  /// タスク名
  name      String
  /// 開始日時
  start     DateTime
  /// 終了日時
  end       DateTime
  /// 作成者email
  createdBy String?  @default("system")
  createdAt DateTime? @default(now())
  /// 更新者email
  updatedBy String?  @default("system")
  updatedAt DateTime? @default(now())
}
