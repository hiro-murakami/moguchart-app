# .env.example
# ローカル開発環境のセットアップ用テンプレート。
# このファイルを .env.local にコピーして、環境に合わせて値を書き換えてください。

# Prisma 接続URL (MySQL)
# 形式: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/gantt_db?allowPublicKeyRetrieval=true"
DATABASE_USER="USER"
DATABASE_PASSWORD="PASSOWRD"
DATABASE_NAME="gantt_db"
DATABASE_HOST="127.0.0.1"
DATABASE_PORT=3306
DATABASE_SOCKET_PATH=""
