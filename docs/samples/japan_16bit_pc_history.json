    {
      "id": 1,
      "projectId": "a30a5815-275b-4c3d-b57a-92371d3efd5b",
      "name": "PC-9801 シリーズ (初代〜VM)",
      "order": 1,
      "visible": true,
      "attribute": {
        "description": "NECのPC-9801シリーズ前期。16bitパソコンの日本標準となり、ビジネス・ゲーム双方で圧倒的なシェアを獲得した「国民機」。",
        "labels": [
          {
            "name": "NEC",
            "color": "#1565c0"
          }
        ]
      },
      "tasks": [
        {
          "id": 101,
          "rowId": 1,
          "name": "PC-9801",
          "start": "1982-10-01T00:00:00",
          "end": "1983-11-01T00:00:00",
          "attribute": {
            "description": "1982年10月発売。μPD8086 8MHz、RAM 128KB。日本初の本格的16bitパソコン。298,000円。GDCによる高速グラフィック処理が特徴。",
            "colorPalette": {
              "name": "NEC Blue",
              "color": "#ffffff",
              "backgroundColor": "#1565c0"
            }
          }
        },
        {
          "id": 102,
          "rowId": 1,
          "name": "PC-9801E / F / M",
          "start": "1983-11-01T00:00:00",
          "end": "1985-07-01T00:00:00",
          "attribute": {
            "description": "1983年11月にPC-9801E発売。廉価版のE、FDD内蔵のF、高速版のMなどバリエーション展開。PC-98の基盤を確立。",
            "colorPalette": {
              "name": "NEC Light Blue",
              "color": "#ffffff",
              "backgroundColor": "#42a5f5"
            }
          }
        },
        {
          "id": 103,
          "rowId": 1,
          "name": "PC-9801VM / VM2 / VM21",
          "start": "1985-07-01T00:00:00",
          "end": "1988-06-01T00:00:00",
          "attribute": {
            "description": "1985年7月にVM発売。V30 CPU 10MHz搭載。EGCによる高速グラフィック。事実上の「標準機」として絶大なシェアを確立。多くのソフトがVM以降対応で開発された。",
            "colorPalette": {
              "name": "NEC Blue",
              "color": "#ffffff",
              "backgroundColor": "#1565c0"
            },
            "labels": [
              {
                "name": "ベストセラー",
                "color": "#e53935"
              },
              {
                "name": "国民機",
                "color": "#ff6f00"
              }
            ]
          }
        }
      ]
    },
    {
      "id": 2,
      "projectId": "a30a5815-275b-4c3d-b57a-92371d3efd5b",
      "name": "PC-9801 シリーズ (VX〜RA〜DA)",
      "order": 2,
      "visible": true,
      "attribute": {
        "description": "PC-9801シリーズ中期。80286/80386搭載で性能が大幅に向上。ゲームプラットフォームとしても全盛期を迎えた。",
        "labels": [
          {
            "name": "NEC",
            "color": "#1565c0"
          }
        ]
      },
      "tasks": [
        {
          "id": 201,
          "rowId": 2,
          "name": "PC-9801VX / UX / CV",
          "start": "1986-10-01T00:00:00",
          "end": "1988-07-01T00:00:00",
          "attribute": {
            "description": "1986年10月にVX発売。80286搭載。VXは高性能モデル、UXは小型モデル、CVは廉価モデル。",
            "colorPalette": {
              "name": "NEC Blue",
              "color": "#ffffff",
              "backgroundColor": "#1565c0"
            },
            "labels": [
              {
                "name": "ベストセラー",
                "color": "#e53935"
              }
            ]
          }
        },
        {
          "id": 202,
          "rowId": 2,
          "name": "PC-9801RA / RS / RX / EX",
          "start": "1988-07-01T00:00:00",
          "end": "1990-05-01T00:00:00",
          "attribute": {
            "description": "1988年7月にRA発売。80386 20MHz搭載。386世代の幕開け。RS/RXは80386SX、EXは廉価版。",
            "colorPalette": {
              "name": "NEC Indigo",
              "color": "#ffffff",
              "backgroundColor": "#3949ab"
            }
          }
        },
        {
          "id": 203,
          "rowId": 2,
          "name": "PC-9801DA / DS / DX / ES",
          "start": "1990-05-01T00:00:00",
          "end": "1992-01-01T00:00:00",
          "attribute": {
            "description": "1990年5月にDA発売。i386DX 20MHz搭載。H98シリーズも同時期に展開。デスクトップ型の成熟期。",
            "colorPalette": {
              "name": "NEC Light Blue",
              "color": "#ffffff",
              "backgroundColor": "#42a5f5"
            }
          }
        }
      ]
    },
    {
      "id": 3,
      "projectId": "a30a5815-275b-4c3d-b57a-92371d3efd5b",
      "name": "PC-9801 シリーズ (FA〜末期)",
      "order": 3,
      "visible": true,
      "attribute": {
        "description": "PC-9801シリーズ後期。i486/Pentium世代へ移行するもDOS/V互換機の台頭で苦戦。1997年のPC-98NX発表で事実上終焉。",
        "labels": [
          {
            "name": "NEC",
            "color": "#1565c0"
          }
        ]
      },
