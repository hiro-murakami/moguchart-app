{
  "name": "functions",
  "private": true,
  "main": "lib/index.js",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "dotenv -e .env -- tsc",
    "build:watch": "tsc --watch",
    "dev": "pnpm run build && (pnpm run build:watch & firebase emulators:start)",
    "serve": "pnpm run build && firebase emulators:start",
    "shell": "pnpm run build && firebase functions:shell",
    "start": "pnpm run shell",
    "setup:env": "node scripts/fetch-env.cjs",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "prisma:generate": "dotenv -e .env -- pnpm exec prisma generate",
    "migrate:create-only": "dotenv -e .env.local -- pnpm exec prisma migrate dev --create-only",
    "migrate:local": "dotenv -e .env.local -- pnpm exec prisma migrate dev",
    "seed:local": "dotenv -e .env.local -- pnpm exec prisma db seed"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "adm-zip": "^0.5.16",
    "dayjs": "^1.11.19",
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.3.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@google-cloud/secret-manager": "^6.1.1",
    "@types/adm-zip": "^0.5.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.23",
    "@types/node": "^22.9.0",
    "dotenv-cli": "^11.0.0",
    "eslint-config-prettier": "^10.1.8",
    "prisma": "^7.4.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  }
}
