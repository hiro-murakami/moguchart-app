// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model GanttChart {
  id        Int      @id @default(autoincrement())
  data      Json     // ガントチャートの行データをJSONとして保存
  createdBy String   @default("system") // 作成者email
  createdAt DateTime @default(now())
  updatedBy String   @default("system") // 更新者email
  updatedAt DateTime @updatedAt
}
