        },
        {
          "id": 303,
          "rowId": 3,
          "name": "PC-9821 Xa/Xt/Xp / V シリーズ",
          "start": "1995-06-01T00:00:00",
          "end": "1997-10-01T00:00:00",
          "attribute": {
            "description": "1995年6月にXa発売。Pentium搭載。Windows 95対応モデル。Vシリーズは汎用モニタ対応でAT互換機に接近。",
            "colorPalette": {
              "name": "NEC Light Blue",
              "color": "#ffffff",
              "backgroundColor": "#42a5f5"
            }
          }
        },
        {
          "id": 304,
          "rowId": 3,
          "name": "PC-9821 Ra / Rv / CEREB",
