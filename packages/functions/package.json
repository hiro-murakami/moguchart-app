  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@prisma/client": "^6.19.1",
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.3.0",
    "lodash": "^4.17.21",
    "dayjs": "^1.11.19"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.23",
    "@types/node": "^22.9.0",
    "eslint-config-prettier": "^10.1.8",
    "prisma": "^6.19.1",
    "typescript": "~5.9.2"
  }
}
