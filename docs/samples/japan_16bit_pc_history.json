          "end": "1995-06-01T00:00:00",
          "attribute": {
            "description": "1993年7月にAp/As/Ae発売。PC-9821シリーズとして256色/65536色表示対応。Windows時代への対応を強化。",
            "colorPalette": {
              "name": "NEC Indigo",
              "color": "#ffffff",
              "backgroundColor": "#3949ab"
            }
