          "name": "PC-9801FA / FS / FX / BX",
          "start": "1992-01-01T00:00:00",
          "end": "1993-07-01T00:00:00",
          "attribute": {
            "description": "1992年1月にFA発売。i486SX/DX搭載。486世代への移行モデル。BXシリーズは廉価版。",
            "colorPalette": {
              "name": "NEC Blue",
              "color": "#ffffff",
              "backgroundColor": "#1565c0"
